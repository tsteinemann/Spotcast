18L634,715L629,713L628,710L630,704L625,702L621,703L620,702L621,704L620,709L625,717L630,718ZM614,701L614,703L617,700L619,701L618,700L619,695L617,696L616,692L614,691L614,690L610,690L609,684L613,682L611,678L606,681L605,688L607,690L611,691L613,695L613,700L614,701ZM523,491L526,496L527,493L533,490L535,485L533,482L530,483L530,484L528,484L524,488L523,491ZM270,642L256,630L245,617L243,617L243,619L250,626L256,635L262,639L265,643L271,646L270,642Z","places":[["Sinclair Dam",703,762,"start"],["Wallace Dam",819,15,"end"],["Little River",190,504,"start"],["Rooty Creek",368,389,"start"],["Beaverdam Creek",436,560,"start"],["Crooked Creek",554,225,"start"]],"km":32.43},"periods":{"winter":{"bass":{"doing":"Largemouth sit deep on drops, humps and roadbeds when it is cold, and slide onto riprap and into pockets on warm, sunny days.","how":[["Warm spells","Crawfish crankbait or lipless crankbait on riprap and in pockets."],["Wood","Jig or shaky head pitched to laydowns."],["Deep","Jigging spoon or drop shot at 20 to 30 ft."]],"bands":[[0,6,"Riprap on","warm days"],[20,30,"Drops and","humps"]],"src":"t"},"crappie":{"doing":"Crappie hold deep, 15 to 30 ft, on deep docks, brush, bridge pilings and creek channels near the mouths of major creeks.","how":[["Docks","Shoot a jig under deep docks and let it fall until it stops."],["Brush","Small spoon or minnow worked slowly over brush."],["Spider rigging","Minnows trolled slowly along creek channels."]],"bands":[[15,30,"Deep docks,","brush, pilings"]],"src":"t"},"linesides":{"doing":"Hybrids and stripers hold 20 to 40 ft deep at creek mouths, humps and drop-offs, and school on top on overcast days. Gulls and loons give them away.","how":[["Downlines","Shad or bass shiners in 25 to 40 ft."],["Schools on top","Popping cork rig, white Rooster Tail or chrome spoon."],["Trolling","Small A-rigs or mid-depth crankbaits."],["When","Topwater is best very early, very late, or on gray days."]],"bands":[[0,5,"Schooling","on gray days"],[25,40,"Downlines","creek mouths"]],"src":"t"}},"prespawn":{"bass":{"doing":"Bass move up as the water reaches the mid 50s: pockets, hydrilla beds, docks, hard-bottom banks, rock, seawalls, red clay and hard sand. The first wave beds in 1 to 4 ft around the March full moon.","how":[["Morning","Plastic swimbait in the backs of pockets."],["Hydrilla","Texas-rigged Junebug lizard."],["Moving baits","Chrome-blue Rat-L-Trap, 1/2 oz chartreuse-white spinnerbait, ChatterBait."],["Fronts","Protected pockets after a front; windy banks on day two and three of warming. Banks with afternoon sun."]],"bands":[[1,8,"Wood, riprap","clay banks"]],"src":"r"},"crappie":{"doing":"Creek channels, the backs of creeks on channel flats, and docks, moving shallower mid-month as the water warms.","how":[["Trolling","1/32 oz jigs in black-blue or white-pink in the creek channels."],["Docks","Shoot docks."]],"bands":[[5,15,"Creek channels","and wood"]],"src":"r"},"linesides":{"doing":"Linesides move toward the rivers and current breaks before spawning, and gather where current meets deep water: river bends, creek mouths and the tops of humps.","how":[["Water under 60°F","Cut shad on a short Carolina rig from an anchored boat."],["Water 60°F and up","Live shad."],["Lures","Bucktails, spoons and small swimbaits cast to current breaks."]],"bands":[[0,8,"Current","breaks"],[10,25,"Humps and","channel drops"]],"src":"t"}},"spawn":{"bass":{"doing":"Bass bed in pockets and creek backs around the full moon, on hard bottom near cover.","how":[["Beds","Texas-rigged lizard, Senko or jig."],["Blind fishing","Swimbait or Fluke in the backs of pockets first thing."]],"bands":[[1,5,"Beds"]],"src":"t"},"crappie":{"doing":"Crappie spawn in the backs of creeks in a few feet of water once it reaches about 62 to 65°F.","how":[["Shallow","Float and jig or minnow in 1 to 6 ft."],["Trolling","Double jig rig longlined across the flats."],["Bank brush","Long rod dipped into cover."]],"bands":[[1,7,"Spawning","shallow"]],"src":"t"},"linesides":{"doing":"Many fish are up the rivers spawning while others feed on the main lake as the shad spawn begins.","how":[["Rivers","Live shad or bucktails at bends and current breaks."],["Main lake","Topwater and flukes at first light on points."]],"bands":[[0,8,"Rivers and","points"],[10,20,"Downlines"]],"src":"t"}},"latespring":{"bass":{"doing":"Shad spawn on riprap and seawalls at dawn, then bass move to bream beds, docks and the first drop off the bank.","how":[["Dawn","Spinnerbait, buzzbait or topwater on riprap and seawalls."],["Bream beds","Pop-R or a weightless Senko."],["Docks","Shaky head skipped into the shade."]],"bands":[[0,6,"Shad spawn","and beds"],[8,15,"First drop"]],"src":"t"},"crappie":{"doing":"Crappie leave the banks for docks and brush in 10 to 15 ft. Singles and small groups are often the bigger fish.","how":[["Docks","Jig skipped into dock shade."],["Brush","Minnows set just above the brush."]],"bands":[[8,15,"Docks and","brush"]],"src":"t"},"linesides":{"doing":"Shad spawn on riprap, seawalls and points at first light, and linesides school on them. By June they move to humps and the main channel.","how":[["Dawn","Topwater, flukes and small swimbaits around riprap and points."],["Live bait","Downlined shad or shiners on humps."],["Schools","Small crankbaits and Swim Shads cast to surfacing fish."]],"bands":[[0,6,"Shad spawn","at dawn"],[12,25,"Humps"]],"src":"t"}},"summer":{"bass":{"doing":"Most bites are shallow: the back of Rooty Creek, Beaverdam Creek and grass. Fish when Georgia Power is moving water, early, mid-morning and late afternoon.","how":[["Moving baits","Chartreuse-white spinnerbait, black buzzbait, No. 7 crankbait."],["Grass","Black Pad Perch frog."],["Worms","Junebug-red Ol Monster."]],"bands":[[0,4,"Topwater","early"],[10,25,"Brush and","roadbeds"]],"src":"r"},"crappie":{"doing":"Lighted docks at night and deep brush piles.","how":[["Brush","Fish slowly from different angles; mark hot spots with a buoy."],["Mayfly hatch","Small yellow-white, all-brown or all-black jigs."],["Fall signal","Shad schooling early and late means the water is cooling."]],"bands":[[12,25,"Over deep","brush"]],"src":"r"},"linesides":{"doing":"Linesides go down-lake to humps, the old river channel and any oxygen lines near the dam. Early mornings bring surface schools; cloudy days fish longer.","how":[["Early","Topwater and flukes to surface schools."],["Humps","Spoons, Sassy Shads and popping corks over the humps."],["Live bait","Downlined shad on humps and the channel edge."],["Generation","Moving water from the dams turns them on."]],"bands":[[0,5,"Surface","schools"],[15,30,"Humps and","channel"]],"src":"t"}},"fall":{"bass":{"doing":"Shad push into creeks and pockets, and bass follow them shallow.","how":[["Shallow","Crankbaits, spinnerbaits and topwater around bait in pockets."],["Cover","Jig or shaky head on wood and docks."]],"bands":[[0,10,"Following shad","in creeks"]],"src":"t"},"crappie":{"doing":"Crappie are on docks and brush early, then pull off cover into roaming schools in the creeks as the water cools.","how":[["Docks","Shoot jigs under docks with brush or shade."],["Schools","Cast a jig just past a school and keep it above them."],["Colors","Bright jigs in clear water, dark after rain."]],"bands":[[5,15,"Docks and","roaming schools"]],"src":"t"},"linesides":{"doing":"As the water cools, schools roam the main lake and creek mouths chasing shad. After turnover, a strong topwater bite usually follows.","how":[["Schools","Cast small swimbaits, spoons or popping corks into busting fish."],["Trolling","Umbrella rigs and A-rigs, white."],["Live bait","Shad on planer boards or freelines at sunup and sundown."]],"bands":[[0,6,"Busting","on top"],[15,30,"Downlines"]],"src":"t"}}},"zones":[{"sp":"bass","p":["winter","prespawn","spawn","latespring","summer","fall"],"name":"Rooty Creek","t":"Shallow bites in the back of the creek; stained water.","src":"r","c":[[436,457,45],[436,458,40]]},{"sp":"bass","p":["winter","prespawn","spawn","latespring","summer","fall"],"name":"Beaverdam Creek","t":"Grass and pockets.","src":"r","c":[[422,560,45]]},{"sp":"bass","p":["prespawn","spawn"],"name":"Pockets and hydrilla, lower lake","t":"Pockets, seawalls and docks near Sinclair Marina.","src":"t","c":[[475,614,40],[528,660,40],[686,626,40]]},{"sp":"bass","p":["latespring","summer"],"name":"Oconee arm below Wallace Dam","t":"Current when Georgia Power is generating.","src":"t","c":[[860,120,45],[760,210,45]]},{"sp":"crappie","p":["winter","prespawn","spawn","latespring","summer","fall"],"name":"Beaverdam Creek","t":"Georgia DNR crappie creek.","src":"r","c":[[422,560,45]]},{"sp":"crappie","p":["winter","prespawn","spawn","latespring","summer","fall"],"name":"Little River riprap (Hwy 441)","t":"Riprap where Hwy 441 crosses the Little River; also Rooty Creek riprap.","src":"r","c":[[422,581,40],[436,457,35]]},{"sp":"crappie","p":["winter","prespawn","spawn","latespring","summer","fall"],"name":"Potato Creek and Twin Bridges (Hwy 212)","t":"Riprap along Hwy 212.","src":"r","c":[[149,704,40],[273,654,35]]},{"sp":"crappie","p":["summer"],"name":"Lighted docks","t":"Night crappie under lights, lower lake.","src":"t","c":[[475,614,40],[560,326,40]]},{"sp":"linesides","p":["winter","fall"],"name":"Main lake and creek mouths","t":"Schools chasing shad on the main lake.","src":"t","c":[[519,499,55],[620,680,55]]},{"sp":"linesides","p":["latespring","summer","prespawn","spawn"],"name":"Below Wallace Dam","t":"Generation current concentrates bait.","src":"t","c":[[860,120,45],[794,179,45]]}],"sources":[["GON Sinclair report, Mar 2021","https://gon.com/?p=653950"],["GON Sinclair report, Sep 2020","https://gon.com/?p=583681"],["Game & Fish: Georgia crappie forecast","https://www.gameandfishmag.com/editorial/georgia-crappie-fishing-forecast-spring-2017/190608"],["Dawson County News: winter crappie","https://www.dawsontimes.com/winter-is-a-prime-time-for-crappie-fishing/"]]}
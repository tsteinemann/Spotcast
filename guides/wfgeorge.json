245L185,1243L190,1242L190,1240L183,1225L181,1224L179,1227L172,1231L170,1237L169,1231L176,1220L172,1215L169,1215L156,1224L163,1216L163,1214L158,1212L168,1211L171,1207L166,1197L163,1195L159,1197L159,1195L153,1188L150,1189L144,1196L142,1197L149,1183L145,1180L145,1182L138,1180L123,1185L137,1178L143,1172L137,1163L135,1157L130,1156L130,1159L129,1154L131,1154L128,1149L108,1148L104,1154L102,1154L101,1157L99,1153L97,1156L98,1153L94,1152L90,1155L86,1163L88,1156L93,1149L92,1148L89,1146L81,1145L79,1143L72,1143L69,1140L70,1138L69,1139L67,1137L66,1143L58,1148L59,1145L62,1144L65,1140L58,1136L55,1135L58,1134L51,1122L54,1124L61,1136L70,1135L72,1132L71,1136L76,1140L84,1138L86,1140L86,1139L94,1141L100,1145L102,1144L96,1138L95,1136L100,1140L102,1140L105,1142L112,1142L118,1141L124,1136L124,1133L129,1132L132,1121L123,1125ZM274,1221L271,1214L258,1209L260,1216L270,1218L274,1221ZM197,1103L183,1113L195,1108L204,1107L199,1106L197,1103Z","places":[["Dam",302,1367,"start"],["Eufaula causeway",133,593,"start"],["Cowikee Creek",178,336,"start"],["Sandy Creek",125,965,"end"],["Chattahoochee River",344,40,"start"]],"km":26.23},"periods":{"winter":{"bass":{"doing":"Deep near cover, and on causeway and railroad riprap where the rock warms in the midday sun.","how":[["Riprap","Slow-rolled crankbait at midday."],["Deep","Jig with a big creature bait, jigging spoon, or a red and black Senko on a Carolina rig."]],"bands":[[0,8,"Sunny riprap"],[15,25,"Deep cover"]],"src":"r"},"crappie":{"doing":"Deeper water on structure; docks downriver and vertical pilings.","how":[["Baits","Minnows and minnow-tipped jigs."],["Pilings","Work jigs on docks and pilings."]],"bands":[[15,30,"Deep docks,","brush, pilings"]],"src":"r"},"linesides":{"doing":"Stripers in the river; hybrids near the bridges, the causeway and the railroad trestle.","how":[["Hybrids","Silver spoons around the bridges and causeway."]],"bands":[[0,5,"Schooling","on gray days"],[25,40,"Downlines","creek mouths"]],"src":"r"}},"prespawn":{"bass":{"doing":"The best time for big fish: pre-spawn females stage on ledges before the flats. Muddy spring water calls for noise.","how":[["Ledges","Deep crankbait and jig."],["Muddy water","Bladed jig, spinnerbait, buzzbait or rattling crankbait in red."]],"bands":[[5,15,"Ledges and","first drops"]],"src":"r"},"crappie":{"doing":"Crappie move from creek mouths toward the middle and backs of creeks onto stumps, laydowns, fish attractors and creek ledges.","how":[["Trolling","Longline or spider-rig jigs and minnows through creek channels."],["Cover","Minnow under a float on laydowns and brush."],["When","Warm afternoons after a few warm days in a row."]],"bands":[[5,15,"Creek channels","and wood"]],"src":"t"},"linesides":{"doing":"Linesides move toward the rivers and current breaks before spawning, and gather where current meets deep water: river bends, creek mouths and the tops of humps.","how":[["Water under 60°F","Cut shad on a short Carolina rig from an anchored boat."],["Water 60°F and up","Live shad."],["Lures","Bucktails, spoons and small swimbaits cast to current breaks."]],"bands":[[0,8,"Current","breaks"],[10,25,"Humps and","channel drops"]],"src":"t"}},"spawn":{"bass":{"doing":"The spawn peaks around the March full moon on flats and in creek pockets, and usually ends in April.","how":[["Beds","Lizard, creature bait or Senko."],["Flats","Spinnerbait and lipless crankbait."]],"bands":[[1,5,"Spawning","flats"]],"src":"t"},"crappie":{"doing":"Crappie spawn in the backs of creeks in a few feet of water once it reaches about 62 to 65°F.","how":[["Shallow","Float and jig or minnow in 1 to 6 ft."],["Trolling","Double jig rig longlined across the flats."],["Bank brush","Long rod dipped into cover."]],"bands":[[1,7,"Spawning","shallow"]],"src":"t"},"linesides":{"doing":"Many fish are up the rivers spawning while others feed on the main lake as the shad spawn begins.","how":[["Rivers","Live shad or bucktails at bends and current breaks."],["Main lake","Topwater and flukes at first light on points."]],"bands":[[0,8,"Rivers and","points"],[10,20,"Downlines"]],"src":"t"}},"latespring":{"bass":{"doing":"Grass thickens. Bass live in matted vegetation and along grass edges.","how":[["Mats","Frog or weightless soft plastic."],["Edges","Texas-rigged worm along the grass line."]],"bands":[[0,6,"Grass"]],"src":"t"},"crappie":{"doing":"Crappie leave the banks for docks and brush in 10 to 15 ft. Singles and small groups are often the bigger fish.","how":[["Docks","Jig skipped into dock shade."],["Brush","Minnows set just above the brush."]],"bands":[[8,15,"Docks and","brush"]],"src":"t"},"linesides":{"doing":"Shad spawn on riprap, seawalls and points at first light, and linesides school on them. By June they move to humps and the main channel.","how":[["Dawn","Topwater, flukes and small swimbaits around riprap and points."],["Live bait","Downlined shad or shiners on humps."],["Schools","Small crankbaits and Swim Shads cast to surfacing fish."]],"bands":[[0,6,"Shad spawn","at dawn"],[12,25,"Humps"]],"src":"t"}},"summer":{"bass":{"doing":"Bass school on river ledges, shell beds and humps, and bite best when the dam is pulling current.","how":[["Ledges","Deep crankbait, football jig or Carolina rig."],["Current","Fish the ledge while water is moving."]],"bands":[[0,4,"Grass early"],[10,25,"River ledges"]],"src":"t"},"crappie":{"doing":"Crappie suspend over deep brush and under shaded docks, just above the thermocline. Night fishing under lights is good.","how":[["Brush","Minnows on a mini Carolina rig, set just above the brush."],["Forward sonar","Cast a small jig from 25 to 30 ft off the brush."],["Night","Lights on a deep dock or bridge."]],"bands":[[12,25,"Over deep","brush"]],"src":"t"},"linesides":{"doing":"Linesides go down-lake to humps, the old river channel and any oxygen lines near the dam. Early mornings bring surface schools; cloudy days fish longer.","how":[["Early","Topwater and flukes to surface schools."],["Humps","Spoons, Sassy Shads and popping corks over the humps."],["Live bait","Downlined shad on humps and the channel edge."],["Generation","Moving water from the dams turns them on."]],"bands":[[0,5,"Surface","schools"],[15,30,"Humps and","channel"]],"src":"t"}},"fall":{"bass":{"doing":"Still shifting toward the winter pattern in a warm fall: first drops on the river ledge, deeper trash piles, shoreline cover and pads.","how":[["Ledge","Shaky head with a blue-black Trick Worm."],["Trash piles","Lipless and lipped crankbaits matched to depth."],["Shoreline","Spinnerbait and frog on cover and pads."]],"bands":[[0,6,"Shallow cover","and pads"],[8,15,"First drops"]],"src":"r"},"crappie":{"doing":"10 to 20 ft on natural and man-made structure.","how":[["Baits","Minnows and minnow-tipped jigs."]],"bands":[[10,20,"Structure"]],"src":"r"},"linesides":{"doing":"As the water cools, schools roam the main lake and creek mouths chasing shad. After turnover, a strong topwater bite usually follows.","how":[["Schools","Cast small swimbaits, spoons or popping corks into busting fish."],["Trolling","Umbrella rigs and A-rigs, white."],["Live bait","Shad on planer boards or freelines at sunup and sundown."]],"bands":[[0,6,"Busting","on top"],[15,30,"Downlines"]],"src":"t"}}},"zones":[{"sp":"bass","p":["winter","prespawn","spawn"],"name":"Eufaula causeway and railroad riprap","t":"Rock that warms in the sun.","src":"r","c":[[119,589,45],[150,640,40]]},{"sp":"bass","p":["prespawn","summer","fall"],"name":"Cowikee Creek","t":"Holes past 30 ft near Lakepoint; deep cranks, jigs, Texas rigs.","src":"r","c":[[178,339,45],[220,370,40]]},{"sp":"bass","p":["summer","fall","prespawn"],"name":"Main river ledges","t":"The old river channel ledges, mid and lower lake.","src":"t","c":[[141,905,45],[218,1099,50],[270,1250,45]]},{"sp":"bass","p":["latespring","spawn"],"name":"Grassy flats and creek pockets","t":"Grass and spawning flats off the main lake.","src":"t","c":[[137,965,40],[108,703,40],[300,1020,40]]},{"sp":"crappie","
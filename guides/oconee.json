L426,1023L422,1027L419,1033L421,1035L419,1039L420,1043L423,1043L429,1039L426,1047L428,1051L432,1051L436,1053L446,1045L455,1044L459,1045ZM694,1302L697,1302L702,1293L700,1291L698,1294L693,1295L694,1302ZM666,1236L672,1240L676,1235L671,1233L671,1229L668,1225L668,1223L664,1222L663,1227L663,1229L666,1231L666,1236ZM616,1011L620,1011L626,1007L625,1001L626,997L624,996L618,1001L616,1011ZM283,553L290,565L288,560L287,556L291,555L295,558L297,555L294,546L294,554L292,554L290,551L287,552L285,550L283,553ZM279,14L274,16L274,19L271,27L271,30L275,34L273,29L273,26L277,21L275,18L279,14ZM264,174L270,181L261,166L260,158L257,156L259,164L256,163L254,165L256,167L258,167L258,171L261,170L262,174L264,174ZM86,327L80,327L80,333L89,342L98,354L99,355L94,346L95,342L88,337L86,333L88,329L86,327Z","places":[["Wallace Dam",742,1372,"start"],["Apalachee River",277,525,"end"],["Oconee River",314,40,"start"],["Richland Creek",490,750,"start"],["Sugar Creek",166,685,"start"],["Lick Creek",237,1027,"end"]],"km":39.09},"periods":{"winter":{"linesides":{"doing":"January: humps mid-lake on both sides, Old Salem Campground to River Bend on the Oconee side and the Ritz to Rocky Creek on the Richland side. February: the south end at 15 to 25 ft, near the dam before spawning and north of the Hwy 44 bridge, then up the Oconee River.","how":[["Trolling","Captain Mack Mini Mack U-rigs 100 to 150 ft back."],["Live bait","Bass shiners 50 to 100 ft back, or dropped into schools."],["Ready rod","A Super Fluke on a spinning rod for sudden schooling."],["Gulls","Gulls sitting on the water mark bait and fish."]],"bands":[[0,5,"Schooling","on gray days"],[25,40,"Downlines","creek mouths"]],"src":"r"},"bass":{"doing":"Seawalls, riprap and docks, plus jigging spoons at 25 to 35 ft on the south end. Riprap on the south end warms unevenly; find the warm stretches. Sunny days are best.","how":[["Seawalls","Flat crankbait or Shad Rap, slowly."],["Docks","Slow-rolled spinnerbait or jig; stay put after a bite."],["Deep","Jigging spoon at 25 to 35 ft."]],"bands":[[0,6,"Riprap on","warm days"],[20,30,"Drops and","humps"]],"src":"r"},"crappie":{"doing":"North end: the upper Apalachee River, Redlands, Windmill and Indian Mounds, about 10 to 12 ft in the river channel. On sunny days they move onto shallow flats.","how":[["Spider rig","16 ft rods with Jiffy Jigs tipped with minnows, slow trolling."],["Timing","About three days either side of a new or full moon."],["After rain","Give it three days after an inch or more of rain."]],"bands":[[10,12,"River channel"],[1,4,"Flats on","sunny days"]],"src":"r"}},"prespawn":{"linesides":{"doing":"Linesides move toward the rivers and current breaks before spawning, and gather where current meets deep water: river bends, creek mouths and the tops of humps.","how":[["Water under 60°F","Cut shad on a short Carolina rig from an anchored boat."],["Water 60°F and up","Live shad."],["Lures","Bucktails, spoons and small swimbaits cast to current breaks."]],"bands":[[0,8,"Current","breaks"],[10,25,"Humps and","channel drops"]],"src":"t"},"bass":{"doing":"Bass move shallow fast in warm, stained water: wood, riprap, red clay and gravel banks in the creeks, and ditches that carry warm water.","how":[["Moving baits","Squarebill, ChatterBait, spinnerbait or lipless crankbait."],["Cover","Jig or Texas-rigged lizard on wood and docks."],["After a front","Fish wind-protected pockets; on day two of warming, fish windy banks."]],"bands":[[1,8,"Wood, riprap","clay banks"]],"src":"t"},"crappie":{"doing":"Crappie move from creek mouths toward the middle and backs of creeks onto stumps, laydowns, fish attractors and creek ledges.","how":[["Trolling","Longline or spider-rig jigs and minnows through creek channels."],["Cover","Minnow under a float on laydowns and brush."],["When","Warm afternoons after a few warm days in a row."]],"bands":[[5,15,"Creek channels","and wood"]],"src":"t"}},"spawn":{"linesides":{"doing":"Many fish are up the rivers spawning while others feed on the main lake as the shad spawn begins.","how":[["Rivers","Live shad or bucktails at bends and current breaks."],["Main lake","Topwater and flukes at first light on points."]],"bands":[[0,8,"Rivers and","points"],[10,20,"Downlines"]],"src":"t"},"bass":{"doing":"Bass bed in pockets and creek backs around the full moon, on hard bottom near cover.","how":[["Beds","Texas-rigged lizard, Senko or jig."],["Blind fishing","Swimbait or Fluke in the backs of pockets first thing."]],"bands":[[1,5,"Beds"]],"src":"t"},"crappie":{"doing":"Crappie spawn in the backs of creeks in a few feet of water once it reaches about 62 to 65°F.","how":[["Shallow","Float and jig or minnow in 1 to 6 ft."],["Trolling","Double jig rig longlined across the flats."],["Bank brush","Long rod dipped into cover."]],"bands":[[1,7,"Spawning","shallow"]],"src":"t"}},"latespring":{"linesides":{"doing":"Shad spawn on riprap, seawalls and points at first light, and linesides school on them. By June they move to humps and the main channel.","how":[["Dawn","Topwater, flukes and small swimbaits around riprap and points."],["Live bait","Downlined shad or shiners on humps."],["Schools","Small crankbaits and Swim Shads cast to surfacing fish."]],"bands":[[0,6,"Shad spawn","at dawn"],[12,25,"Humps"]],"src":"t"},"bass":{"doing":"Fish move to summer patterns: dock shade and long points, especially in Richland Creek. Points with shell or gravel get more bites.","how":[["Points","Carolina rig."],["Docks","Shade on the docks."]],"bands":[[0,6,"Shad spawn","and beds"],[8,15,"First drop"]],"src":"r"},"crappie":{"doing":"Crappie leave the banks for docks and brush in 10 to 15 ft. Singles and small groups are often the bigger fish.","how":[["Docks","Jig skipped into dock shade."],["Brush","Minnows set just above the brush."]],"bands":[[8,15,"Docks and","brush"]],"src":"t"}},"summer":{"linesides":{"doing":"June: the oxygen bubble lines the pumpback creates at the dam. August: humps from Tornado Point to Wallace Dam. Mornings, and cloudy days are better.","how":[["Bubble lines","Cast to surface strikes between the lines; drop or troll bait into the bubbles."],["Humps","Spoons, Sassy Shads and popping corks."],["Topwater","Bone Pop-R early."]],"bands":[[0,5,"Surface","schools"],[15,30,"Humps and","channel"]],"src":"r"},"bass":{"doing":"Deeper seawalls, and an early bite at The Bullhole that lasts about an hour.","how":[["Early","Zara Spook or Skitter Pop."],["Later","Deep crankbait, worm, jig, or shaky head and Ned rig."]],"bands":[[0,4,"Topwater","early"],[10,25,"Brush and","roadbeds"]],"src":"r"},"crappie":{"doing":"Stuck to trees, brush piles and stumps all over the lake. Find cover with side and down imaging.","how":[["Minnows","Dropped just above the highest fish, then worked down 2 ft at a time."],["Marker","Drop a marker on each tree first."]],"bands":[[12,25,"Over deep","brush"]],"src":"r"}},"fall":{"linesides":{"doing":"As the water cools, schools roam the main lake and creek mouths chasing shad. After turnover, a strong topwater bite usually follows.","how":[["Schools","Cast small swimbaits, spoons or popping corks into busting fish."],["Trolling","Umbrella rigs and A-rigs, white."],["Live bait","Shad on planer boards or freelines at sunup and sundown."]],"bands":[[0,6,"Busting","on top"],[15,30,"Downlines"]],"src":"t"},"bass":{"doing":"Shad push into creeks and pockets, and bass follow them shallow.","how":[["Shallow","Crankbaits, spinnerbaits and topwater around bait in pockets."],["Cover","Jig or shaky head on wood and docks."]],"bands":[[0,10,"Following shad","in creeks"]],"src":"t"},"crappie":{"doing":"Crappie are on docks and brush early, then pull off cover into roaming schools in the creeks as the water cools.","how":[["Docks","Shoot jigs under docks with brush or shade."],["Schools","Cast a jig just past a school and keep it above them."],["Colors","Bright jigs in clear water, dark after rain."]],"bands":[[5,15,"Docks and","roaming schools"]],"src":"t"}}},"zones":[{"sp":"linesides","p":["winter"],"name":"Mid-lake humps, Oconee side","t":"Old Salem Campground to River Bend.","src":"r","c":[[296,773,50],[294,633,45]]},{"sp":"linesides","p":["winter"],"name":"Mid-lake humps, Richland side","t":"The Ritz to Rocky Creek.","src":"r","c":[[595,951,50],[620,1019,40]]},{"sp":"linesides","p":["winter","prespawn"],"name":"South end and Wallace Dam","t":"Fish gather here in February before spawning.","src":"r","c":[[708,1312,55],[624,1230,55]]},{"sp":"linesides","p":["prespawn","spawn"],"name":"Up the Oconee River","t":"The spawning run.","src":"r","c":[[248,123,45],[300,260,45]]},{"sp":"linesides","p":["latespring","summer"],"name":"Humps, Tornado Point to Wallace Dam","t":"Humps on the lower lake and the dam bubble lines.","src":"r","c":[[708,1312,55],[620,1200,50],[450,1150,50]]},{"sp":"bass","p":["winter","fall"],"name":"South-end riprap","t":"Riprap and seawalls; find warm stretches.","src":"r","c":[[650,1250,50],[708,1312,45]]},{"sp":"bass","p":["latespring","summer"],"name":"Richland Creek points and docks","t":"Long points with shell or gravel.","src":"r","c":[[560,900,55],[619,1020,50]]},{"sp":"bass","p":["prespawn","spawn"],"name":"Creek pockets","t":"Sugar, Lick and Richland creek pockets.","src":"t","c":[[138,784,45],[270,1043,40],[563,912,40]]},{"sp":"crappie","p":["winter","prespawn"],"name":"Upper Apalachee River","t":"Redlands, Windmill and Indian Mounds on the north end.","src":"r","c":[[137,390,50],[221,484,45],[27,238,40]]},{"sp":"crappie","p":["winter","prespawn","spawn","latespring","summer","fall"],"name":"Sugar Creek","t":"Georgia DNR crappie creek with brush piles.","src":"r","c":[[138,784,45]]},{"sp":"crappie","p":["winter","prespawn","spawn","latespring","summer","fall"],"name":"Richland Creek","t":"Georgia DNR crappie creek.","src":"r","c":[[563,912,45]]},{"sp":"crappie","p":["spawn","latespring","summer","fall"],"name":"Timber in the upper lake","t":"Trees and brush; mark them first.","src":"t","c":[[290,220,50],[350,321,40]]}],"sources":[["GON Oconee report, Jan 2024","https://gon.com/?p=1025845"],["GON Oconee report, Feb 2019","https://gon.com/fishing-reports/lake-oconee-fishing-report-february-2019"],["GON Oconee report, June 2024","https://gon.com/?p=1058382"],["GON Oconee report, Aug 2023","https://gon.com/?p=985310"],["Game & Fish: Georgia crappie forecast","https://www.gameandfishmag.com/editorial/georgia-crappie-fishing-forecast-spring-2017/190608"],["Dawson County News: winter crappie","https://www.dawsontimes.com/winter-is-a-prime-time-for-crappie-fishing/"]]}
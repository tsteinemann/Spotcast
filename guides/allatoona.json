5,272L194,267L199,269L205,263L205,261L203,263L197,264L195,261L202,259L202,256L204,252L204,250L205,247L204,241L190,233L199,235L207,233L207,232L206,225L204,221L208,224L209,228L211,230L214,229L215,227L215,223L218,223L220,224L218,232L220,235L226,237L231,237L237,242L240,242L241,239L244,242L253,232L253,218L247,216L245,215L244,213L241,213L244,210L242,202L249,207L251,208L255,207L256,203L264,207L274,204L275,201L277,200L282,180L286,178L292,180L295,177L294,175L291,174L273,163L280,157L281,153L286,152L284,144L281,142L257,143L259,142L256,132L259,135L263,135L261,126L256,119L248,114L256,115L256,113L259,112L263,118L268,120L267,112L269,108L271,111L270,116L278,133L283,138L286,136L288,136L290,140L290,143L293,145L294,149L294,152L290,154L286,159L285,162L287,162L303,171L298,184L300,185L310,180L319,180L326,186L331,186L332,188L330,190L326,190L323,189L321,184L313,183L301,193L292,192L286,194L281,201L284,207L280,204L277,208L271,208L267,210L254,212L256,216L258,227L257,232L254,236L255,239L259,240L261,235L264,234L262,239L264,242L263,242L244,247L242,248L242,252L241,253L239,249L226,241L216,241L213,243L214,250L217,252L220,256L216,254L213,255L212,262L210,267L212,271L215,271L213,274L209,287L221,291L231,291L233,293L226,292L223,294L215,294L222,299L222,303L223,305L226,307L230,305L229,310L233,313L223,312L219,309L210,308L203,314L204,320L200,319L198,322L202,327L204,326L208,327L210,326L209,321L213,321L216,318L217,321L219,321L221,327L224,328L230,326L229,329L230,331L235,331L237,328L240,328L247,324L244,329L246,332L240,333L233,337L238,346L242,349L240,350ZM500,591L509,597L511,595L510,593L507,589L502,588L500,591ZM286,188L293,189L294,188L294,186L292,184L287,184L285,186L286,188ZM79,532L78,538L80,541L75,540L78,543L78,545L73,544L73,546L71,547L71,552L68,552L69,554L71,554L73,560L79,561L79,558L81,556L90,550L91,548L90,541L86,538L91,538L89,534L83,532L79,532ZM70,537L67,541L67,544L72,544L71,538L70,537Z","places":[["Dam",47,433,"start"],["Knox Bridge",798,100,"end"],["Bells Ferry",742,405,"end"],["Little River",858,423,"start"],["Allatoona Creek",144,786,"start"],["S-turns",630,350,"start"],["Acworth",60,1150,"start"]],"km":52.91},"periods":{"winter":{"stripers":{"doing":"Stripers follow bait into the middle and backs of creeks. On calm, cloudy mornings they roll on top; after a cold front they drop deeper and need live bait.","how":[["Find them","Gulls and loons over the water, then bait on the graph."],["On top","Lead-head fluke, bucktail or small jerkbait cast to rolling fish."],["Live bait","Blueback herring or trout on freelines, or downlines when fish are deep."],["After a front","Downlines or a four-arm umbrella rig trolled slowly."]],"bands":[[0,8,"Rolling on top","in creeks"],[20,40,"Downlines","after fronts"]],"src":"t"},"hybrids":{"doing":"Hybrids and stripers hold 20 to 40 ft deep at creek mouths, humps and drop-offs, and school on top on overcast days. Gulls and loons give them away.","how":[["Downlines","Shad or bass shiners in 25 to 40 ft."],["Schools on top","Popping cork rig, white Rooster Tail or chrome spoon."],["Trolling","Small A-rigs or mid-depth crankbaits."],["When","Topwater is best very early, very late, or on gray days."]],"bands":[[0,5,"Schooling","on gray days"],[25,40,"Downlines","creek mouths"]],"src":"t"},"spots":{"doing":"Spotted bass group up deep on ditches, channel swings, roadbeds and bluffs, often 25 to 45 ft, and move little.","how":[["Deep","Drop shot, jigging spoon or blade bait on the fish you mark."],["Bluffs and rock","Jerkbait or football jig, slowly."],["Early","Some school in shallow ditch backs at first light; slow-roll an underspin."]],"bands":[[25,45,"Ditches and","channels"]],"src":"t"},"crappie":{"doing":"The big bite starts in December when a front drops the water into the mid to low 50s. Trolling starts at 58 to 62°F or when the lake hits 830 ft.","how":[["Trolling","1/24 and 1/16 oz heads, 0.7 to 1.2 mph, zig-zag between shallow and deep."],["Colors","Natural in clear water; bright with contrasting heads in stained water."]],"bands":[[3,15,"Open water,","12-15 ft"]],"src":"r"}},"prespawn":{"stripers":{"doing":"Stripers push up the rivers and creeks with the herring as the water warms through the 50s. The upper lake and river channels hold the most fish.","how":[["Planer boards","Herring or gizzard shad about 40 ft behind the boards."],["Flatlines","Unweighted bait 60 to 120 ft back on slow days."],["Where","Creek backs on warm afternoons; points and clay banks are steadier."]],"bands":[[0,12,"Boards and","flatlines"],[20,25,"Schools","marked here"]],"src":"t"},"hybrids":{"doing":"Linesides move toward the rivers and current breaks before spawning, and gather where current meets deep water: river bends, creek mouths and the tops of humps.","how":[["Water under 60°F","Cut shad on a short Carolina rig from an anchored boat."],["Water 60°F and up","Live shad."],["Lures","Bucktails, spoons and small swimbaits cast to current breaks."]],"bands":[[0,8,"Current","breaks"],[10,25,"Humps and","channel drops"]],"src":"t"},"spots":{"doing":"Spots move up rocky and clay points toward spawning pockets. They hold on the sides of long points and on rock piles from 5 to 30 ft.","how":[["Points","A 1/4 oz ball-head swimbait crawled across rocky points."],["Finesse","Ned rig, shaky head or drop shot on the sides of long points."],["Wind","Jerkbait on windy points and riprap."],["Bottom","Skip points with mushy bottoms; pea gravel and chunk rock hold fish."]],"bands":[[5,30,"Rocky points"]],"src":"t"},"crappie":{"doing":"Crappie move from creek mouths toward the middle and backs of creeks onto stumps, laydowns, fish attractors and creek ledges.","how":[["Trolling","Longline or spider-rig jigs and minnows through creek channels."],["Cover","Minnow under a float on laydowns and brush."],["When","Warm afternoons after a few warm days in a row."]],"bands":[[5,15,"Creek channels","and wood"]],"src":"t"}},"spawn":{"stripers":{"doing":"Herring stage up the creeks and stripers school on top for the first couple of hours of light, then settle to 25 to 35 ft in the same areas.","how":[["First light","Topwater and freelined bluebacks over the herring."],["After the sun is up","Downline bluebacks at 25 to 35 ft nearby."],["Clouds","A cloudy morning can keep the topwater bite going to mid-morning."]],"bands":[[0,6,"Topwater","at dawn"],[25,35,"Downlines","mid-day"]],"src":"t"},"hybrids":{"doing":"Many fish are up the rivers spawning while others feed on the main lake as the shad spawn begins.","how":[["Rivers","Live shad or bucktails at bends and current breaks."],["Main lake","Topwater and flukes at first light on points."]],"bands":[[0,8,"Rivers and","points"],[10,20,"Downlines"]],"src":"t"},"spots":{"doing":"Largemouth bed in pockets in the 60s; spotted bass bed deeper, often 10 to 15 ft, on gravel and flat rock. The full moon pushes waves of fish up.","how":[["Beds","Shaky head, wacky rig or Fluke around beds and the bank between them."],["Points","Jerkbait across the points into spawning coves."]],"bands":[[2,15,"Beds; spots","deeper"]],"src":"t"},"crappie":{"doing":"Crappie spawn in the backs of creeks in a few feet of water once it reaches about 62 to 65°F.","how":[["Shallow","Float and jig or minnow in 1 to 6 ft."],["Trolling","Double jig rig longlined across the flats."],["Bank brush","Long rod dipped into cover."]],"bands":[[1,7,"Spawning","shallow"]],"src":"t"}},"latespring":{"stripers":{"doing":"The herring spawn on points, clay banks, riprap and marina walls at first light, and stripers crash them. By June they slide to brush on points in 15 to 35 ft, then deeper.","how":[["Dawn","Walking bait, popper or wake bait on points and humps."],["Live bait","Herring pitched or freelined to points."],["Later","Downlines over brush in 15 to 35 ft."]],"bands":[[0,6,"Topwater","at dawn"],[15,35,"Brush on","points"]],"src":"t"},"hybrids":{"doing":"Shad spawn on riprap, seawalls and points at first light, and linesides school on them. By June they move to humps and the main channel.","how":[["Dawn","Topwater, flukes and small swimbaits around riprap and points."],["Live bait","Downlined shad or shiners on humps."],["Schools","Small crankbaits and Swim Shads cast to surfacing fish."]],"bands":[[0,6,"Shad spawn","at dawn"],[12,25,"Humps"]],"src":"t"},"spots":{"doing":"Bass key on the herring and shad spawn on hard banks at dawn, then move to brush on points and humps as the water heads into the 80s.","how":[["Dawn","Topwater or wake bait on clay points, bridges and marina walls."],["Parallel","Underspin, white spinnerbait or Fluke run along walls and riprap."],["Later","Drop shot or shaky head on brush in 15 to 25 ft."]],"bands":[[0,6,"Bait spawn","at dawn"],[15,25,"Brush"]],"src":"t"},"crappie":{"doing":"Crappie leave the banks for docks and brush in 10 to 15 ft. Singles and small groups are often the bigger fish.","how":[["Docks","Jig skipped into dock shade."],["Brush","Minnows set just above the brush."]],"bands":[[8,15,"Docks and","brush"]],"src":"t"}},"summer":{"stripers":{"doing":"The lake stratifies. Stripers drop below the thermocline, usually about 30 ft and deeper, and move down-lake toward the dam and deep channels.","how":[["Downlines","Live herring 30 to 80 ft down; change bait every 5 to 7 minutes."],["Lead core","A white bucktail trolled about 2.8 mph to find fish, then stop and drop."],["Power reeling","Drop a big spoon to the bottom and burn it up through the school."],["Timing and care","First light to about 10 a.m. Release fish fast; surface water over 80°F stresses them."]],"bands":[[30,50,"Below the","thermocline"],[60,100,"Deep near","the dam"]],"src":"t"},"hybrids":{"doing":"The south end has the best bite: main-lake points, humps at the mouths of main creeks, the dam and the flats at Kellogg. Good evening bite at the dam.","how":[["Live bait","Shiners on downlines; bring about two dozen."],["Big fish","Umbrella rigs trolled near the mouth of Tanyard Creek."],["Downriggers","For the summer depth."]],"bands":[[0,5,"Surface","schools"],[15,30,"Humps and","channel"]],"src":"r"},"spots":{"doing":"Main-lake points early, brush later in the month for better size. Shad are the forage.","how":[["Early","Topwater."],["Overcast","Jerkbait and jig-head minnow; fish scatter on cloudy days."],["Sun","Jig in brush, where fish bury."]],"bands":[[0,4,"Topwater","early"],[15,45,"Brush on points","and humps"]],"src":"r"},"crappie":{"doing":"Brush in 16 to 22 ft with the tops at 12 to 15 ft, and deep-water docks. About 12 to 14 ft in early June, 15 to 18 ft once the thermocline sets up.","how":[["Spider rig","Minnows on a mini Carolina rig, 1/2 oz egg sinker, No. 2 to 4 Aberdeen hook."],["Forward sonar","1/16 to 3/32 oz head with a 1.5 inch minnow, 25 to 30 ft off the brush."],["Colors","Natural in clear water, bright on sunny days."]],"bands":[[12,18,"Brush tops","12-15 ft"]],"src":"r"}},"fall":{"stripers":{"doing":"Coming back down out of the rivers. The bigger fish are on the north end, from the Little River arm up toward Fields Landing and south to Kellogg Creek, with some mid-lake.","how":[["Bait","Gizzard shad, the best November bait; shad and herring into December."],["Rig","Planer boards and weightless freelines."],["When","Sunup and sundown."],["Trolling","Umbrella rigs and A-rigs, white, as the month goes on."]],"bands":[[0,8,"Schools","on top"],[10,30,"Spoon under","marked fish"]],"src":"r"},"hybrids":{"doing":"Schooling and surfacing from the dam to the S-turns and along the channel in front of Clear Creek. Easy to find, but they move often and eat very small baits.","how":[["Busting","They hit almost anything thrown into the school."],["Picky","Downsize to match tiny shad."],["Down","Shiners or small trout below the school."],["Birds","Allatoona has few loons; diving gulls give them away."]],"bands":[[0,6,"Busting","on top"],[15,30,"Downlines"]],"src":"r"},"spots":{"doing":"The crankbait bite builds and stays the main bite into mid-December. Fish relate to rock in 9 to 12 ft and to wind-blown points and pockets with bait.","how":[["Main bait","Crankbait around rock, mixed with a jerkbait."],["Slow it down","Little Spotty jig across main-lake rock and bluffs."],["Deeper","Drop shot at 12 to 25 ft or a 1/2 oz football jig."],["Timing","Shallow cranking is best in the late afternoon."]],"bands":[[6,12,"Crank, jerk;","rock 9-12 ft"],[12,25,"Drop shot"]],"src":"r"},"crappie":{"doing":"On brush early in November, then off cover into schools of 10 to 15 that roam the major creeks, suspended 6 to 10 ft or on bottom at 14 to 18 ft.","how":[["Early November","Troll slowly over brush, jigs just above it."],["Late November","Cast a jig past a school and keep it above them; keep boat noise down."],["Where in the creek","Start halfway up and work toward the mouth."],["Jigs","1/32 to 1/16 oz heads, orange-based colors."]],"bands":[[6,10,"Suspended","6-10 ft"],[14,18,"On bottom","14-18 ft"]],"src":"r"}}},"zones":[{"sp":"stripers","p":["fall","winter"],"name":"Upper Etowah arm","t":"From Knox Bridge down toward Fields Landing and Sweetwater Creek.","src":"r","c":[[814,162,70],[845,215,100],[761,302,85]]},{"sp":"stripers","p":["fall","winter"],"name":"Little River arm","t":"From the Bells Ferry bridge up the Little River.","src":"r","c":[[778,433,60],[884,463,70]]},{"sp":"stripers","p":["fall"],"name":"Mid-lake to Kellogg Creek","t":"The south end of the November striper range.","src":"r","c":[[600,600,80],[607,610,55]]},{"sp":"stripers","p":["prespawn","spawn"],"name":"Up the Etowah and Little River","t":"Fish run up the rivers in spring.","src":"t","c":[[814,162,70],[880,465,65]]},{"sp":"stripers","p":["latespring","summer"],"name":"South end and the dam","t":"Deeper main-lake water near the dam in summer.","src":"t","c":[[82,422,60],[144,600,70]]},{"sp":"hybrids","p":["fall","winter"],"name":"Dam to the S-turns","t":"Schools surface along the main channel.","src":"r","c":[[75,430,55],[175,410,60],[257,477,60],[316,545,55],[420,570,60],[510,600,60]]},{"sp":"hybrids","p":["fall","winter"],"name":"S-turns and Clear Creek channel","t":"Schools move between here and the dam.","src":"r","c":[[578,526,55],[600,420,60],[351,486,45]]},{"sp":"hybrids","p":["latespring","summer"],"name":"South end: dam, points and Kellogg flats","t":"Main-lake points, humps at creek mouths, the dam and the Kellogg flats.","src":"r","c":[[82,422,60],[600,640,60],[316,545,50]]},{"sp":"hybrids","p":["latespring","summer"],"name":"Tanyard Creek mouth","t":"Umbrella rigs for bigger fish.","src":"r","c":[[300,800,50]]},{"sp":"hybrids","p":["prespawn","spawn"],"name":"Upper lake and rivers","t":"Hybrids and white bass run up the rivers in spring.","src":"t","c":[[814,162,60],[880,465,55]]},{"sp":"spots","p":["fall","winter"],"name":"Lower-lake rock and bluffs","t":"Rock in 9 to 12 ft; jig the bluffs when cranking slows.","src":"r","c":[[205,460,70],[130,600,75]]},{"sp":"spots","p":["fall","winter","summer"],"name":"Main-lake points","t":"Wind-blown points and pockets with bait.","src":"r","c":[[442,577,75],[560,560,70]]},{"sp":"spots","p":["prespawn","spawn","latespring"],"name":"Creek pockets and points","t":"Points leading into Kellogg, Illinois and Clear creeks.","src":"t","c":[[340,476,50],[607,610,55],[250,470,50]]},{"sp":"crappie","p":["winter","prespawn","spawn","latespring","summer","fall"],"name":"Illinois and Clear creeks","t":"Georgia DNR fish attractor creek.","src":"r","c":[[340,476,48]]},{"sp":"crappie","p":["winter","prespawn","spawn","latespring","summer","fall"],"name":"Kellogg Creek","t":"Georgia DNR fish attractor creek.","src":"r","c":[[607,610,52]]},{"sp":"crappie","p":["winter","prespawn","spawn","latespring","summer","fall"],"name":"Tanyard Creek","t":"Georgia DNR fish attractor creek off the Allatoona Creek arm.","src":"r","c":[[313,803,52]]},{"sp":"crappie","p":["winter","prespawn","spawn","latespring","summer","fall"],"name":"Sweetwater Creek","t":"Georgia DNR fish attractor creek.","src":"r","c":[[718,262,48]]},{"sp":"crappie","p":["fall","winter","prespawn"],"name":"Little River arm creeks","t":"Schools leave brush for these creeks.","src":"t","c":[[905,470,48]]}],"sources":[["GON Allatoona report, Nov 2024","https://gon.com/?p=1094317"],["GON Allatoona report, Dec 2024","https://gon.com/?p=1101515"],["GON Allatoona report, Dec 2023","https://gon.com/?p=1018516"],["GON Allatoona report, June 2025","https://gon.com/fishing-reports/lake-allatoona-fishing-report-june-2025"],["Game & Fish: Georgia crappie forecast","https://www.gameandfishmag.com/editorial/georgia-crappie-fishing-forecast-spring-2017/190608"],["Dawson County News: winter crappie","https://www.dawsontimes.com/winter-is-a-prime-time-for-crappie-fishing/"]]}